# Auth básica del panel — obligatoria en cuanto se expone fuera de localhost.
DASHBOARD_USER=
DASHBOARD_PASS=
# Levanta el panel y/o el túnel público (cloudflared) al arrancar el bot.
DASHBOARD_AUTOSTART=0
TUNNEL_AUTOSTART=0

TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
TELEGRAM_VIP_CHANNEL_ID=your_vip_channel_id_here
TELEGRAM_VIP_PRICE_STARS=250
VIP_DURATION_DAYS=30

ODDS_API_KEY=your_odds_api_key_here

MIN_ODDS=1.35
# Tope de cuota para emitir. 2.2 desde 2026-08-27 (ver .env para la medicion).
PICK_MAX_ODDS=2.2
MIN_EDGE=0.04
# Piso y techo de edge para todo pick real. 2026-09-23: MIN_EDGE 0.03->0.04,
# MAX_EDGE 0.08->0.14, tras medir EN VIVO que el 0.08 (aplicado 2026-09-15)
# empeoro el ROI del heuristico (+3.8% -> -2.9%, n=273) mientras el learned
# mejoraba en la misma ventana sin cambio de config (control). Por bucket de
# edge sobre el historico completo, la zona dulce real es 4-14%, no 0-8%:
# el 0-4% rinde -2.5% (n=362) y el 8-14% que el 0.08 cortaba rinde +5-6.6%.
# Con 0.04-0.14: ROI +4.8% (n=1244) vs +2.2% de la ventana anterior. Detalle
# completo y como volver atras: ver .env.
MAX_EDGE=0.14
# Techo de edge SOLO para el modelo aprendido — distinto de MAX_EDGE porque
# ahi la cola alta de edge no colapsa (ver backtest 2026-09-16).
MAX_EDGE_LEARNED=0.20
# 2026-09-23: explorado 0.65 y 0.72, se mantiene en 0.70 — ninguno mejora
# (0.65 emitiria un grupo de control con ROI -2.2%; 0.72 recortaria una
# franja 0.70-0.72 que rinde MEJOR que lo que quedaria arriba). Ver .env.
MIN_CONF=0.70
# PILOTO (2026-09-25, VACIO = DESACTIVADO): piso de conf distinto SOLO para los
# "menos de X<=3.5" de futbol. Medido sobre rejected_picks (rechazados solo por
# min_conf, desde 2026-08-10, bootstrap por evento): N=11,285 ev, ROI +9.6% IC95%
# [+8.0, +11.3] vs +3.8% [-0.4, +7.6] de lo emitido en la misma ventana; TRAIN
# <09-01 +8.3%, TEST >=09-01 +11.1%; sobrevive al retraso de ejecucion medido con
# pick_exec_probe (desliz. medio <0.6%). `conf` no ordena dentro del segmento.
# LIMITES: precio de primer avistamiento (no ejecutable) y medido con MIN_EDGE/
# MAX_EDGE previos al 2026-09-23. Sin tope el segmento pasaria de ~5 a ~190
# picks/dia: NO activar sin UNDER_LOW_DAILY_CAP. Sugerido: MIN_CONF_UNDER_LOW=0
# (quita el piso; conf no aporta) con tope 15. Vaciarlo cierra el experimento.
MIN_CONF_UNDER_LOW=
# Tope diario (dia UTC) de picks emitidos por debajo de MIN_CONF, por orden de
# llegada. Simulado con 15/dia: ROI +13.0% IC95% [+5.8, +20.0] (n=586 ev), igual
# que elegir al azar (control +8.4%, rango 2.1-14.5): la seleccion por hora es neutra.
UNDER_LOW_DAILY_CAP=15
GOLDEN_MIN_CONF=0.70
GOLDEN_MIN_ODDS=1.35

# tiered = escalonado por mercado + línea + f_apertura. NO lee `conf`, a
# diferencia de kelly/half_kelly: por eso un modelo mal calibrado no puede
# inflar el tamaño de la apuesta (ver el incidente de adopción de agosto).
STAKE_MODE=tiered
# Techo del escalonado. 1.8 (ver .env: se probo 1.2 y se revirtio).
STAKE_TIER_HIGH=1.8
STAKE_MIN=0.1
STAKE_MAX=5.0
STAKE_UNIT_SCALE=20

# heuristic = ignora el modelo | shadow = lo calcula y guarda, decide el
# heurístico | learned = decide el modelo.
# En shadow `conf`, `edge` y `stake` salen idénticos a heuristic; lo único que
# cambia es que se persiste conf_learned (y el badge 🔥 en Telegram). Es el modo
# para acumular historial fuera de muestra sin arriesgar nada.
MODEL_MODE=shadow

# Veto del modelo: exige que un pick pase AMBOS umbrales, conf_heuristic Y
# conf_learned. El modelo sólo puede QUITAR picks, nunca añadir — a diferencia
# de MODEL_MODE=learned, que le deja decidir `conf` y con ello cambiar qué
# población se emite.
# Medido fuera de muestra el 2026-08-19: a 0.70 recorta ~23% del volumen y deja
# el P/L igual o peor (+29.5u con veto vs +30.4u sin él, N=439). Por eso viene
# apagado. Falla abierto: sin conf_learned la puerta deja pasar.
MODEL_VETO=0
MODEL_VETO_MIN_CONF=0.70
SCORE_VERSION=2
BLOCK_OVERS_IN=futbol
EXCLUDE_SPORTS=
AUTO_PICKS=true
AUTO_PICK_MAX_PER_HOUR=6
AUTO_PICK_NOTIFY=true

# --- Runtime: guardas contra el bot "vivo pero mudo" ------------------------
# pruneSnapshots es SÍNCRONO (better-sqlite3): mientras corre no se ejecuta nada
# más en el proceso. Por eso no se llama al arrancar sino PRUNE_DELAY_MS después,
# y cada pasada se acota a PRUNE_MAX_MS.
PRUNE_MAX_MS=2000
PRUNE_DELAY_MS=60000

# Watchdog del ciclo del sampler. Si un await interno se cuelga, el guard de
# instancia única se quedaría puesto y el bot dejaría de muestrear PARA SIEMPRE,
# sin error y sin morirse. Pasado este tiempo se da el ciclo por perdido y se
# arranca otro: solaparse es mucho menos malo que enmudecer.
SAMPLE_STUCK_MS=300000

# -----------------------------------------------------------------------------
# PILOTO DE ESTADISTICAS DE PARTIDO - captura de solo lectura (src/matchStats.js)
# -----------------------------------------------------------------------------
# QUE HACE: muestrea los mercados de TOTAL de CORNERS y TARJETAS de los partidos
# de futbol en vivo, los guarda en stat_snapshots, y cuando el partido termina
# escribe su etiqueta en stat_results. No puntua, no emite, no apuesta, no toca
# el firewall ni el modelo. Se ve en el panel "Estadisticas".
#
# POR QUE EXISTE APARTE. El bot consume GetLiveOverview (una llamada por
# DEPORTE) y ahi no vienen estos mercados: estan solo en GetEventDetails, que es
# una llamada por PARTIDO. Por eso va en su propio intervalo, con su propio tope
# y su propio interruptor - y NO dentro del ciclo del sampler, que es el camino
# critico que emite.
#
# COBERTURA MEDIDA el 2026-08-29 sobre 30 partidos de futbol en vivo:
#   corners        5/30 (17%)
#   tarjetas       3/30 (10%)  <- subconjunto de los de corners: salen gratis,
#                                 mismo partido y misma llamada
#   tiros a puerta   0/30      <- NO EXISTEN en este feed, ni en partidos con
#                                 168 mercados. No hay endpoint de estadisticas
#                                 (ocho nombres probados, todos 404). Cerrado.
#   faltas / fueras de juego: 0/30
#
# LO QUE VIENE A VALIDAR: si sale ETIQUETA. Sin resultado no se entrena nada.
#   - Corners: el conteo se infiere del mercado del N-esimo (si cotizan el 7o,
#     han caido 6). Verificado funcionando, pero la casa lo retira antes del
#     final en algunos partidos: eso es una etiqueta CENSURADA, y cuantas haya
#     decide si esto es viable.
#   - Tarjetas: no tienen ese canal. Solo se pueden etiquetar por precio
#     colapsado (una cuota <= 1.05 es mercado ya resuelto).
#   - Cuando la evidencia no alcanza, lado_ganador queda NULL A PROPOSITO. Antes
#     sin etiqueta que una inventada: rellenar con la mejor conjetura es como se
#     fabricaron las features de global_draw, y dejo 184 picks inservibles.
#
# CUIDADO AL LEER EL PANEL: la "deriva" es hacia donde MUEVE la linea, no si el
# mercado acierta. Eso solo lo diran las etiquetas, y solo cuando haya bastantes.
#
# RETENCION: pruneSnapshots solo borra de `snapshots`. stat_snapshots y
# stat_results no las poda nadie todavia.
STATS_PILOT=1
# Cada cuantos minutos corre el piloto. Mas bajo = mas resolucion y mas
# llamadas, y ademas mas probabilidad de pillar el mercado antes de que se
# cierre (que es lo que da etiqueta). El ratelimit global (MAX_REQ_PER_MIN)
# sigue mandando por encima.
STATS_MINUTES=3
# Tope de partidos por ciclo. Con ~34 de futbol en vivo, 40 los cubre todos y
# pone un techo duro si algun dia la parrilla se dispara.
STATS_MAX_EVENTS=40
# Cinturon anti-cuelgue del ciclo. MAS LARGO que el del sampler (300000) a
# proposito: un ciclo del piloto son ~32 llamadas HTTP compartiendo el
# ratelimit con el sampler, y puede pasar de 5 min sin estar colgado. Con el
# umbral corto el watchdog arrancaba un segundo ciclo encima del primero, que
# DUPLICA las llamadas — y aqui enmudecer es barato (es un experimento, no la
# emision), mientras que solaparse sale caro. Si un ciclo tarda mas que
# STATS_MINUTES, el guard simplemente se salta el tick siguiente, que es lo
# correcto.
STATS_STUCK_MS=900000
# Ciclos seguidos sin ver un partido en el feed antes de darlo por terminado y
# etiquetarlo. Un partido puede faltar un ciclo por un hueco del feed, y
# liquidar a la primera etiquetaria como final un estado intermedio.
STATS_AUSENCIAS=2

# PICKS DE CORNERS EN REGISTRO (src/cornerPicks.js) — experimento. Telegram SOLO al chat del dueño, sin
# stake, tabla corner_picks aparte, liquidacion automatica contra el conteo final de FotMob.
# NO es un pick validado: el modelo de corners no ha mostrado ventaja sobre el mercado (validacion
# cruzada 2026-09-19, 88 partidos: original -25% ROI; calibrado empatado con el mercado, ROI -8% a +7%
# con IC ±23pp). Sirve para acumular N fuera de muestra. Umbrales PROVISIONALES (no optimizados).
# Requiere STATS_PILOT=1 y FOTMOB_PILOT=1. CORNER_PICKS=0 lo apaga.
CORNER_PICKS=0
CORNER_MIN_EDGE=0.15
CORNER_MIN_MINUTO=15
CORNER_MAX_MINUTO=80
CORNER_ODD_MIN=1.30
CORNER_ODD_MAX=3.50
CORNER_MAX_POR_HORA=6

# -----------------------------------------------------------------------------
# PILOTO FotMob (src/fotmobScraper.js) — segunda fuente de corners
# -----------------------------------------------------------------------------
# Captura el conteo de corners DIRECTO (estadistica real, no inferida del
# indice de un mercado como el piloto de arriba). Fuente: FotMob, via fetch
# plano (src/fotmobScraper.js) — verificado en produccion que responde 200
# sin ningun JS-challenge, a diferencia del piloto anterior (SofaScore,
# bloqueaba con 403 y necesitaba Chromium headless; suspendido 2026-09-14).
#
# APAGADO por defecto.
FOTMOB_PILOT=0
FOTMOB_MINUTES=3
# Cinturon anti-cuelgue: si un ciclo tarda mas que esto, se da por colgado y
# se arranca otro en vez de acumular ciclos zombis.
FOTMOB_STUCK_MS=180000

# -----------------------------------------------------------------------------
# PILOTO PRE-PARTIDO (src/fetcher.js: fetchPrematch) — captura de solo lectura
# -----------------------------------------------------------------------------
# Guarda el historial de cuotas de partidos de futbol AUN NO INICIADOS
# (GetEvents, hasta 31 dias adelante medido el 2026-09-22), para medir si el
# movimiento de linea entre apertura y cierre ("steam") predice el resultado
# — señal documentada en la literatura de apuestas, nunca antes capturable en
# este proyecto porque no habia feed pre-partido conectado. UNA sola llamada
# trae todos los partidos programados de un deporte con mercados y cuotas
# incluidos (a diferencia del piloto de corners, que necesita una llamada por
# partido). No puntua, no emite, no apuesta, no toca el firewall ni el
# modelo. Sin liquidacion todavia: eso llega cuando haya suficiente historial
# de apertura/cierre acumulado.
#
# APAGADO por defecto.
PREMATCH_PILOT=0
# Los precios pre-partido se mueven mucho mas lento que los en vivo — no hace
# falta el intervalo de 1-3 min del sampler/otros pilotos.
PREMATCH_MINUTES=60
PREMATCH_STUCK_MS=300000
PREMATCH_SPORT_ID=66

# Escaneo de valor pre-partido vs. casa sharp (src/prematchValue.js) — compara
# la cuota de Playdoit contra Pinnacle/Betfair AHORA MISMO, sin esperar a
# acumular steam. Comparte presupuesto de creditos con src/sharp.js
# (SHARP_MAX_CREDITS_PER_DAY): cada liga escaneada cuesta 1 credito. Validado
# el 2026-09-22 en EPL+LaLiga (100% de emparejamiento). Solo lectura.
PREMATCH_SHARP_SCAN=0
PREMATCH_SHARP_SCAN_MINUTES=240
PREMATCH_SHARP_SCAN_LIGAS_POR_CICLO=3
PREMATCH_SHARP_SCAN_STUCK_MS=300000
PREMATCH_SHARP_SCAN_DESTACADO_PCT=5

# xG de temporada por equipo (FotMob /data/teams?id=X), señal pre-partido que
# no depende de otra casa ni de esperar movimiento de linea. Ver .env.
PREMATCH_XG_PILOT=1
PREMATCH_XG_MINUTES=120
PREMATCH_XG_EVENTOS_POR_CICLO=10
PREMATCH_XG_STUCK_MS=300000

# NB de corners CALIBRADO contra los finales reales de FotMob
# (src/nbCalibrado.js, parametros en fotmob_nb.json; se reentrena con
# `node scripts/entrenar-nb-fotmob.js`). El NB original sobrestimaba mu (12.985
# vs 9.75 real) y asumia 90' exactos: subestimaba ~1.6x lo que falta entre el
# 65' y el 85', y fabricaba edges de Under de 10-47pp que perdian dinero
# (ROI ~-25% en 88 partidos, ver scripts/backtest-picks-nb-fotmob.js).
# on = usa la calibracion (sella p_poisson como stats-5 y los pronosticos como
# nb-cal-1); off = modelo original. Requiere reiniciar bot y dashboard.
STATS_NB_CALIBRADO=off

# -----------------------------------------------------------------------------
# ALERTAS DE VALOR (scripts/alertas-valor.js)
# -----------------------------------------------------------------------------
# Lee los picks que el heuristico YA emitio, se queda con los de la banda de
# valor medida, y manda uno a Telegram. NO coloca apuestas.
#
# UMBRALES MEDIDOS sobre 3.554 picks liquidados en 49 dias:
#   todo lo emitido             +3.94%  [1.7,  6.2]   72.5/dia
#   Under + Futbol + edge 3-8%  +9.48%  [4.1, 14.8]   10.8/dia  <- esta config
#
# EL EDGE ES UNA BANDA, NO UN PISO. Subir el piso empeora de forma monotona
# (>=3% +3.74%, >=5% +3.22%, >=10% +1.75%, >=15% +0.53%) y la cola alta pierde
# dinero (>=20%: -3.89%, WR 53.5%). Un edge enorme es el modelo discrepando
# mucho del mercado, y de media el mercado tiene razon.
#
# OJO: ese +9.48% se eligio sobre la misma muestra que lo produjo, entre unas
# seis combinaciones, asi que esta inflado. Mide el resultado hacia delante.
ALERTA_EDGE_MIN=0.03
ALERTA_EDGE_MAX=0.08
ALERTA_SOLO_UNDER=1
ALERTA_DEPORTES=Fútbol
# Cada cuanto mira la tabla de picks. No pega al feed: es una consulta local.
# 60s y no 300s porque un pick vive p50 36 min, p95 1.3 h — 300s se comeria
# hasta el 14% de la ventana util.
ALERTA_INTERVALO_SEG=60
# Edad maxima del pick para alertarlo. Sin este techo, el primer arranque veria
# miles de picks historicos sin alertar y los mandaria todos de golpe.
ALERTA_MAX_EDAD_MIN=20
ALERTA_MAX_POR_CICLO=5
# Canal de destino. Si se omite, usa TELEGRAM_CHAT_ID.
# ALERTA_CHAT_ID=

# -----------------------------------------------------------------------------
# NIVEL 0 DE APUESTA DIRECTA (src/execProbe.js) — solo mide, NO apuesta
# -----------------------------------------------------------------------------
# Tras emitir cada pick (heuristico y modelo) se vuelve a leer su mercado a
# +10/+30/+60 s y se guarda la cuota vista y si seguia abierto (tabla
# pick_exec_probe). Sin credenciales: solo lee el feed publico. Costo: ~3
# llamadas extra por pick. Reporte: node scripts/exec-probe-report.js [dias] [model|heur]
# 0 lo apaga.
EXEC_PROBE=1

# Reporte pre-partido diario (src/reportePrematch.js) — pedido 2026-09-25. Imagen 9:16 (valor vs Pinnacle,
# parlay de 3-4 patas, mas probables) + CSV con todas las jugadas del dia, al canal VIP y al dueno.
# Solo lectura: no gasta cuota de API ni toca el firewall/modelo. Requiere PREMATCH_PILOT=1.
# NO hay record pre-partido: "seguro" = probabilidad justa (cuota sin margen), no rendimiento medido; las patas
# mostradas se guardan en prematch_report_picks y se liquidan solas para construir ese record (evaluar con N e IC).
# PREMATCH_REPORT=0 lo apaga. Hora en CDMX; /prematch (solo dueno) manda una vista previa sin tocar el canal VIP.
PREMATCH_REPORT=1
PREMATCH_REPORT_HORA=08:00
# Canal extra del reporte (Golden picks): id numerico del canal (-100...), con el bot como administrador.
# TELEGRAM_GOLDEN_CHANNEL_ID=
